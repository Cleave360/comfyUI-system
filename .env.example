# Local service bindings
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
JAZZY_HOST=127.0.0.1
JAZZY_PORT=8075
JAZZY_FRONTEND_HOST=127.0.0.1
JAZZY_FRONTEND_PORT=8070

# Set a strong token before binding Jazzy to a non-loopback address.
JAZZY_WS_TOKEN=
JAZZY_ALLOWED_ORIGINS=http://127.0.0.1:8070,http://localhost:8070
JAZZY_MAX_MESSAGE_BYTES=1048576

# Assistant provider: auto | ollama | anthropic
JAZZY_ASSISTANT_PROVIDER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Governed workflow dispatch. Required by governance.policy.toml.
ADAPTIVE_BASE=http://127.0.0.1:8080
ADAPTIVE_API_KEY=
JAZZY_PRINCIPAL_ID=local-operator
JAZZY_PRINCIPAL_TYPE=human
JAZZY_LEASE_ID=
JAZZY_AGENT_INSTANCE_ID=
JAZZY_AUDIT_TIMEOUT_SECONDS=5
