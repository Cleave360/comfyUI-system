# Local governance evidence (append-only, never committed)
.kindred/

# macOS and editor metadata
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp

# Python environments and generated bytecode
.venv/
venv/
**/.venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/

# Credentials and local configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*token*.md
*.pem
*.key
*.p12

# Logs, runtime state, and caches
*.log
logs/
**/logs/
temp/
**/temp/

# Local ComfyUI user state. Preserve portable workflow definitions only.
user/*
!user/default/
user/default/*
!user/default/workflows/
!user/default/workflows/**

# Generated and local media. Keep user/default/workflows below.
models/
input/
output/
voices/

# Agent transcripts and imported conversation artifacts
claude/
copilot_history/
gemini/

# Upstream/source checkouts are managed separately and are not vendored into
# the orchestration repository. Their local Git metadata and changes remain
# untouched.
ComfyUI-source/
cleave_comfyui/
kindred-avatar/WhisperLiveKit/

# Local avatar memory databases
kindred-avatar/backend/memory/

# Failed placeholder downloads; the avatar UI uses its sphere fallback.
kindred-avatar/frontend/robot.gltf
kindred-avatar/frontend/RobotExpressive.bin
